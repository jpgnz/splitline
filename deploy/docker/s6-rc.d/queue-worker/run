#!/command/with-contenv sh
set -eu

if [ -z "${APP_KEY:-}" ] && [ -s /data/.app_key ]; then
    APP_KEY="$(tr -d '\r\n' < /data/.app_key)"
    export APP_KEY
fi

PRIMARY_QUEUE="${DB_QUEUE:-default}"
QUEUES="${PRIMARY_QUEUE}"
case ",${QUEUES}," in
    *,streams,*) ;;
    *) QUEUES="${QUEUES},streams" ;;
esac
case ",${QUEUES}," in
    *,weather,*) ;;
    *) QUEUES="${QUEUES},weather" ;;
esac

if [ "$(id -u)" -eq 0 ]; then
    exec s6-setuidgid www-data php /var/www/html/artisan queue:work --queue="${QUEUES}" --sleep=3 --tries=5 --timeout=600
fi

exec php /var/www/html/artisan queue:work --queue="${QUEUES}" --sleep=3 --tries=5 --timeout=600
