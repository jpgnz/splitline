#!/command/with-contenv sh
set -eu

if [ -z "${APP_KEY:-}" ] && [ -s /data/.app_key ]; then
    APP_KEY="$(tr -d '\r\n' < /data/.app_key)"
    export APP_KEY
fi

if [ "$(id -u)" -eq 0 ]; then
    exec s6-setuidgid www-data php /var/www/html/artisan schedule:work
fi

exec php /var/www/html/artisan schedule:work
