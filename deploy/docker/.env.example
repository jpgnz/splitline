# Splitline Self-Hosting Environment Configuration
# Copy to .env in deploy/docker/ before running `docker compose up -d`.

# External URL used to generate links and redirects (use https:// behind a reverse proxy)
APP_URL=http://localhost:8080

# Your local IANA timezone (defaults to UTC; also honors TZ)
# Examples: Europe/London, America/New_York, Pacific/Auckland, Asia/Tokyo
TIMEZONE=UTC

# Garmin Connect Personal API key (required for syncing Garmin health & activity data)
GARMIN_KEY=

# Initial display units before customizing in Settings: metric | imperial
DEFAULT_UNITS=metric

# Initial Sports & Disciplines navigation mode: auto | custom
DEFAULT_SPORTS_MODE=auto

# Reverse proxy configuration:
# Set TRUSTED_PROXIES=* (or your proxy CIDR/IP) and SESSION_SECURE_COOKIE=true when serving over HTTPS
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=false

# Send Laravel logs to container stderr (visible via `docker logs splitline`)
LOG_CHANNEL=stderr

# Optional: leave unset to auto-generate once and persist in /data/.app_key
# APP_KEY=

# Optional: automatically queue FIT stream & GNSS route downloads for newly synced activities
# GARMIN_AUTO_SYNC_STREAMS=true

# Optional: Open-Meteo historical activity weather (free, no API key required)
# OPEN_METEO_ENABLED=true
# OPEN_METEO_AUTO_SYNC=true
