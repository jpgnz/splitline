APP_NAME=Splitline
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

TIMEZONE=UTC
DEFAULT_UNITS=metric
DEFAULT_SPORTS_MODE=auto

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/data/database.sqlite
# DB_SQLITE_BUSY_TIMEOUT=5000
# DB_SQLITE_JOURNAL_MODE=WAL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=false
# TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

VITE_APP_NAME="${APP_NAME}"

# Garmin Connect Personal API Provider
GARMIN_KEY=

# Optional overrides — commented values are built-in defaults; leave commented unless changing.

# Open-Meteo historical activity weather — free, no API key required (defaults listed below)
# OPEN_METEO_ENABLED=true
# OPEN_METEO_AUTO_SYNC=true

# OpenStreetMap Nominatim reverse geocoding — ODbL (defaults listed below)
# Setting NOMINATIM_EMAIL is recommended on the public OSMF endpoint. See README.md for advanced tuning.
# NOMINATIM_EMAIL=
# NOMINATIM_ENABLED=true
# NOMINATIM_AUTO_SYNC=true
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Folder auto-import for standalone .fit / .zip files (disabled until AUTO_IMPORT_DIR is set; defaults listed below)
# AUTO_IMPORT_DIR=
# AUTO_IMPORT_MODE=keep
# AUTO_IMPORT_MIN_FILE_AGE_SECONDS=5
